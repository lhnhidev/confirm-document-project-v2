{
  "name": "confirm-documents-app",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend/web"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev --workspace=apps/backend\" \"npm run dev --workspace=apps/frontend/web\"",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend/web",
    "build": "npm run build --workspace=apps/frontend/web",
    "lint": "npm run lint --workspace=apps/frontend/web"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@types/multer": "^2.2.0",
    "concurrently": "^10.0.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10"
  }
}
