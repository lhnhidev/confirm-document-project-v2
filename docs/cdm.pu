@startuml CDM_EvidenceManagement

skinparam linetype ortho
skinparam classAttributeIconSize 0

' ================= STYLING =================
skinparam nodesep 60
skinparam ranksep 50
skinparam padding 6

skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

' ================= CLASSES =================

class User {
    +userId : String
    +fullName : String
    +role : String
    ' role: Teacher, DepartmentHead, SchoolBoard
    +email : String
    +phoneNumber : String
    +departmentName : String
    +username : String
    +password : String
}

class Field {
    +field : String
    +fieldName : String
    +percent: Float
}

class Criterion {
    +criteriaId : String
    +criteriaName : String
}

class Evidence {
    +evidenceId : String
    +title : String
    +description : String
    +date : DateTime
    +originalFileName : String
    +fileFormat : String
    +fileSize : Long
    +urlFile : String
    +currentStatus : String
    ' currentStatus: Pending, Approved, Rejected, NeedsSupplement
}

' ================= RELATIONSHIPS & LAYOUT =================

' Ép xếp User nằm bên trái, Field nằm bên phải
User "1" -right-> "8" Field

' Đi thẳng từ Field xuống Criterion (hàng dưới)
Field "1" -down-> "1..*" Criterion

' Ép xếp Evidence nằm bên trái (ngay dưới User), Criterion nằm bên phải
Evidence "1" <-left- "1" Criterion

' Nối từ User xuống Evidence ở hàng dưới (2 ô nằm ngay sát dưới nhau nên đường nối ngắn lại)
User "1" -down-> "0..*" Evidence

@endl
